  <!-- ════════════════════════════════════════════
       PAGE 2 : API 규격서
  ════════════════════════════════════════════ -->
  <diagram name="API 규격서" id="api_page">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <!-- 제목 -->
        <mxCell id="api_title" value="PatentAI - API 규격서 초안" style="text;html=1;fontStyle=1;fontSize=18;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="600" height="35" as="geometry" />
        </mxCell>

        <!-- ── 상담 API ── -->
        <mxCell id="g_consult" value="상담 에이전트 API" style="swimlane;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="620" height="180" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="POST /api/consultation/start" style="text;html=1;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="g_consult"><mxGeometry x="0" y="30" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="a1d" value="Request: { user_id, message, file_path? }   Response: { consultation_idx, reply, missing_slots, completeness_score }" style="text;html=1;fontSize=10;align=left;spacingLeft=16;fontColor=#555;" vertex="1" parent="g_consult"><mxGeometry x="0" y="50" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="a2" value="POST /api/consultation/continue" style="text;html=1;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="g_consult"><mxGeometry x="0" y="80" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="a2d" value="Request: { user_id, consultation_idx, message }   Response: { reply, missing_slots, completeness_score }" style="text;html=1;fontSize=10;align=left;spacingLeft=16;fontColor=#555;" vertex="1" parent="g_consult"><mxGeometry x="0" y="100" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="a3" value="GET /api/consultation/{user_id}/{consultation_idx}" style="text;html=1;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="g_consult"><mxGeometry x="0" y="130" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="a3d" value="Response: { summary_problem, summary_solution, summary_difference, summary_effect, algorithm_steps }" style="text;html=1;fontSize=10;align=left;spacingLeft=16;fontColor=#555;" vertex="1" parent="g_consult"><mxGeometry x="0" y="150" width="620" height="20" as="geometry" /></mxCell>

        <!-- ── 선행기술 API ── -->
        <mxCell id="g_prior" value="선행기술 조사 API" style="swimlane;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="620" height="130" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="POST /api/prior-art/search" style="text;html=1;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="g_prior"><mxGeometry x="0" y="30" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="b1d" value="Request: { user_id, consultation_idx }   Response: { candidates[], novelty_risk, inventive_step_risk, analysis_summary }" style="text;html=1;fontSize=10;align=left;spacingLeft=16;fontColor=#555;" vertex="1" parent="g_prior"><mxGeometry x="0" y="50" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="b2" value="GET /api/prior-art/{user_id}/{consultation_idx}" style="text;html=1;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="g_prior"><mxGeometry x="0" y="80" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="b2d" value="Response: { candidates[], overlap_points, difference_points, novelty_risk }" style="text;html=1;fontSize=10;align=left;spacingLeft=16;fontColor=#555;" vertex="1" parent="g_prior"><mxGeometry x="0" y="100" width="620" height="20" as="geometry" /></mxCell>

        <!-- ── 청구항 API ── -->
        <mxCell id="g_claim" value="청구항 에이전트 API" style="swimlane;fontStyle=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="620" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cl1" value="POST /api/claims/generate" style="text;html=1;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="g_claim"><mxGeometry x="0" y="30" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="cl1d" value="Request: { user_id, consultation_idx }   Response: { claim_1, dependent_claims, claim_strategy_notes }" style="text;html=1;fontSize=10;align=left;spacingLeft=16;fontColor=#555;" vertex="1" parent="g_claim"><mxGeometry x="0" y="50" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="cl2" value="GET /api/claims/{user_id}/{consultation_idx}" style="text;html=1;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="g_claim"><mxGeometry x="0" y="80" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="cl2d" value="Response: { id, claim_1, dependent_claims, created_at }" style="text;html=1;fontSize=10;align=left;spacingLeft=16;fontColor=#555;" vertex="1" parent="g_claim"><mxGeometry x="0" y="100" width="620" height="20" as="geometry" /></mxCell>

        <!-- ── 도면 API ── -->
        <mxCell id="g_drawing" value="도면 에이전트 API" style="swimlane;fontStyle=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="620" height="155" as="geometry" />
        </mxCell>
        <mxCell id="dr_1" value="POST /api/drawings/generate" style="text;html=1;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="g_drawing"><mxGeometry x="0" y="30" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="dr_1d" value="Request: { user_id, consultation_idx }   Response: { figures[{ fig_number, diagram_type, quality_score, svg_url }] }" style="text;html=1;fontSize=10;align=left;spacingLeft=16;fontColor=#555;" vertex="1" parent="g_drawing"><mxGeometry x="0" y="50" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="dr_2" value="GET /api/drawings/{user_id}/{consultation_idx}" style="text;html=1;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="g_drawing"><mxGeometry x="0" y="80" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="dr_2d" value="Response: { drawings[{ id, fig_number, diagram_title, quality_score, quality_grade, svg_content }] }" style="text;html=1;fontSize=10;align=left;spacingLeft=16;fontColor=#555;" vertex="1" parent="g_drawing"><mxGeometry x="0" y="100" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="dr_3" value="GET /api/drawings/{id}/svg" style="text;html=1;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="g_drawing"><mxGeometry x="0" y="130" width="620" height="20" as="geometry" /></mxCell>

        <!-- ── 명세서 API ── -->
        <mxCell id="g_spec" value="발명의 설명 에이전트 API" style="swimlane;fontStyle=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="700" y="70" width="620" height="155" as="geometry" />
        </mxCell>
        <mxCell id="sp_1" value="POST /api/specification/generate" style="text;html=1;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="g_spec"><mxGeometry x="0" y="30" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="sp_1d" value="Request: { user_id, consultation_idx }   Response: { tech_field, background_art, problem_statement, solution_means, effects, detailed_desc }" style="text;html=1;fontSize=10;align=left;spacingLeft=16;fontColor=#555;" vertex="1" parent="g_spec"><mxGeometry x="0" y="50" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="sp_2" value="GET /api/specification/{user_id}/{consultation_idx}" style="text;html=1;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="g_spec"><mxGeometry x="0" y="80" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="sp_2d" value="Response: { tech_field, background_art, problem_statement, solution_means, effects, drawing_description, detailed_desc, embodiments }" style="text;html=1;fontSize=10;align=left;spacingLeft=16;fontColor=#555;" vertex="1" parent="g_spec"><mxGeometry x="0" y="100" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="sp_3" value="GET /api/specification/{user_id}/{consultation_idx}/export" style="text;html=1;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="g_spec"><mxGeometry x="0" y="130" width="620" height="20" as="geometry" /></mxCell>

        <!-- ── 파이프라인 (전체 실행) API ── -->
        <mxCell id="g_pipeline" value="전체 파이프라인 API (LangGraph)" style="swimlane;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="700" y="250" width="620" height="130" as="geometry" />
        </mxCell>
        <mxCell id="pp1" value="POST /api/pipeline/run" style="text;html=1;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="g_pipeline"><mxGeometry x="0" y="30" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="pp1d" value="Request: { user_id, consultation_idx, target_agents[]? }   Response: { job_id, status: queued }" style="text;html=1;fontSize=10;align=left;spacingLeft=16;fontColor=#555;" vertex="1" parent="g_pipeline"><mxGeometry x="0" y="50" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="pp2" value="GET /api/pipeline/status/{job_id}" style="text;html=1;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="g_pipeline"><mxGeometry x="0" y="80" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="pp2d" value="Response: { job_id, status: running|completed|failed, current_agent, progress_pct, errors[] }" style="text;html=1;fontSize=10;align=left;spacingLeft=16;fontColor=#555;" vertex="1" parent="g_pipeline"><mxGeometry x="0" y="100" width="620" height="20" as="geometry" /></mxCell>

        <!-- ── 챗봇 API ── -->
        <mxCell id="g_chat" value="챗봇 API (기존 구현)" style="swimlane;fontStyle=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666;" vertex="1" parent="1">
          <mxGeometry x="700" y="400" width="620" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ch1" value="POST /api/chat" style="text;html=1;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="g_chat"><mxGeometry x="0" y="30" width="620" height="20" as="geometry" /></mxCell>
        <mxCell id="ch1d" value="Request: { messages[] }   Response: { reply }   Model: GPT-4o-mini / max_tokens: 400" style="text;html=1;fontSize=10;align=left;spacingLeft=16;fontColor=#555;" vertex="1" parent="g_chat"><mxGeometry x="0" y="50" width="620" height="20" as="geometry" /></mxCell>

        <!-- HTTP 메서드 범례 -->
        <mxCell id="api_legend" value="POST = 생성/실행   GET = 조회   초안 기준 - 5/19 멘토링에서 확정 예정" style="text;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666;align=left;spacingLeft=8;" vertex="1" parent="1">
