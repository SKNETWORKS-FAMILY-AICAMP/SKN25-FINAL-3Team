%% 1020180025971 - 베리에이셔널 오토인코더 구조
%% 생성일: 2026-05-11

classDiagram
    class 변환모듈 {
        +String 독성가스분산데이터
        +transform()
    }
    class 생성모듈 {
        +String 변환된데이터
        +generateModel()
    }
    class 오토인코더 {
        +String 2D데이터
        +compress()
        +extractFeatures()
    }
    class 컨볼루션레이어 {
        +detectFeatures()
    }
    class 완전연결된레이어 {
        +mapVariables()
    }
    변환모듈 --> 생성모듈 : "데이터를 생성 모듈에 전달"
    생성모듈 --> 변환모듈 : "변환 모듈과 연결"
    변환모듈 --> 오토인코더 : "변환 모듈의 일부"
    오토인코더 --> 컨볼루션레이어 : "오토인코더의 구성 요소"
    생성모듈 --> 완전연결된레이어 : "생성 모듈의 구성 요소"