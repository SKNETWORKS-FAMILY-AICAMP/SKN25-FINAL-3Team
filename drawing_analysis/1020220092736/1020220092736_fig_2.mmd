classDiagram
    class 클라이언트 {
        +String 사용자정보
    }
    class 이커머스플랫폼관리서버 {
        +String 서비스정보
        +데이터수집()
        +서비스제공()
    }
    class 데이터수집부 {
        +String 도시데이터
        +데이터제공()
    }
    class 상장여부판단부 {
        +String 판단기준
        +상장여부결정()
    }
    class IPO서비스부 {
        +String IPO정보
        +상장진행()
    }
    class 증권거래서비스부 {
        +String 거래정보
        +거래운영()
    }
    
    클라이언트 --> 이커머스플랫폼관리서버 : "서비스 요청"
    이커머스플랫폼관리서버 --> 데이터수집부 : "데이터 수집"
    데이터수집부 --> 상장여부판단부 : "상장 여부 판단"
    상장여부판단부 --> IPO서비스부 : "상장 결정"
    IPO서비스부 --> 증권거래서비스부 : "증권 거래 관리"