%% 1020250109740 - 딥러닝을 이용한 해양포유류 식별 시스템 구성도
%% 생성일: 2026-05-11

classDiagram
    class 인공지능서버 {
        +String 이미지데이터
        +데이터전달()
        +데이터저장()
    }
    class 웹서버 {
        +String 요청데이터
        +데이터요청()
    }
    class 이미지전처리모듈 {
        +String 전처리된이미지
        +전처리()
    }
    class 라벨링모듈 {
        +String 라벨링된데이터
        +라벨링()
    }
    class 모델생성모듈 {
        +String 딥러닝모델
        +모델생성()
    }
    class 데이터베이스 {
        +String 저장데이터
        +데이터관리()
    }
    
    웹서버 --> 인공지능서버 : "데이터 요청"
    인공지능서버 --> 데이터베이스 : "데이터 저장"
    인공지능서버 --> 이미지전처리모듈 : "데이터 전달"
    이미지전처리모듈 --> 라벨링모듈 : "전처리된 이미지 전달"
    라벨링모듈 --> 모델생성모듈 : "라벨링된 데이터 전달"