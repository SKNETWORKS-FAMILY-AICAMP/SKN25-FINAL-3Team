%% 생성일: 2026-05-11

classDiagram
    class 사용자관리부 {
        +String 사용자명
        +String 관리코드
    }
    class 가상지갑관리부 {
        +String 가상코인정보
        +manage()
    }
    class 코인충전차감부 {
        +String 결제정보
        +charge()
        +deduct()
    }
    class 리더기 {
        +String 쓰레기용기코드
        +read()
    }
    class 사용자단말 {
        +String 사용자정보
        +request()
    }
    사용자관리부 --> 가상지갑관리부 : "사용자 정보 제공"
    가상지갑관리부 --> 코인충전차감부 : "가상코인 전달"
    리더기 --> 코인충전차감부 : "가상코인 차감 요청"
    사용자단말 --> 코인충전차감부 : "결제정보 제공"