classDiagram
    class 하우징 {
        +String 내부수납공간
        +지지구조()
    }
    class 가열부재 {
        +String 코일
        +가열()
    }
    class 전력공급부 {
        +String 전력
        +전력공급()
    }
    class 제어부 {
        +String 진동정보
        +String 영상정보
        +전력제어()
    }
    class 진동센서 {
        +String 진동정보
        +정보제공()
    }
    class 통신부 {
        +String 영상정보
        +정보제공()
    }
    class 탑플레이트 {
        +String 지지구조
    }
    
    하우징 --> 탑플레이트 : "하우징의 상부에 배치됨"
    전력공급부 --> 가열부재 : "전력을 공급받음"
    제어부 --> 전력공급부 : "제어부에 의해 제어됨"
    제어부 --> 진동센서 : "진동 센서로부터 정보를 수신함"
    제어부 --> 통신부 : "카메라로부터 영상을 수신함"
    진동센서 --> 제어부 : "정보를 제공함"
    통신부 --> 제어부 : "정보를 제공함"