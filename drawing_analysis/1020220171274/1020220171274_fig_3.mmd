classDiagram
    class 해상풍력터빈 {
        +String 구조물정보
        +설치됨()
    }
    class 지반 {
        +String 지반정보
    }
    class 환경하중 {
        +String 하중데이터
        +영향을미침()
    }
    class 세굴취약도 {
        +String 취약도데이터
        +평가됨()
    }
    class 세굴위험도 {
        +String 위험도데이터
        +결합됨()
    }
    해상풍력터빈 --> 지반 : "설치됨"
    환경하중 --> 해상풍력터빈 : "영향을 미침"
    세굴취약도 --> 해상풍력터빈 : "평가됨"
    세굴위험도 --> 세굴취약도 : "결합됨"