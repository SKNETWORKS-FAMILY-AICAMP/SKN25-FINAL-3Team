classDiagram
    class AttentionNetwork {
        +String inputSequence
        +process()
    }
    class AttentionBlock {
        +String query
        +String key
        +String value
        +generateOutput()
    }
    class AttentionLayer {
        +applyAttentionMechanism()
    }
    class GatingLayer {
        +applyGatingMechanism()
    }
    AttentionNetwork --> AttentionBlock : "구성"
    AttentionBlock --> AttentionLayer : "구성"
    AttentionBlock --> GatingLayer : "구성"