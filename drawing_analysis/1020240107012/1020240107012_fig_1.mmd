classDiagram
    class 회원관리부 {
        +회원가입()
        +회원정보관리()
    }
    class 매칭서비스부 {
        +피보호자와 요양보호사 매칭()
    }
    class 요양보호서비스부 {
        +서비스 제공()
    }
    class 모니터링부 {
        +서비스 모니터링()
    }
    class 커뮤니티 관리부 {
        +커뮤니티 형성()
    }
    class 사용자메뉴 관리부 {
        +개인 이력 관리()
    }
    class 데이터베이스부 {
        +데이터 저장()
    }
    class 회원정보획득모듈 {
        +회원 프로필 정보 획득()
    }
    class 회원등급관리모듈 {
        +회원 등급 부여 및 관리()
    }

    회원관리부 --> 회원정보획득모듈 : "회원관리부에 정보 제공"
    회원관리부 --> 회원등급관리모듈 : "회원관리부에 등급 정보 제공"
    회원관리부 --> 매칭서비스부 : "회원정보를 기반으로 매칭"
    매칭서비스부 --> 요양보호서비스부 : "서비스 제공을 위한 매칭"
    요양보호서비스부 --> 모니터링부 : "서비스 모니터링"