classDiagram
    class 가상박람회부 {
        +String 플랫폼
        +visualizeStructure()
    }
    class 관리서버 {
        +String 데이터관리
        +controlOperations()
    }
    class 가입부 {
        +String 회원정보
        +processRegistration()
    }
    class 모형제작부 {
        +String 축소모형
        +createModel()
    }
    class 도면변환부 {
        +String 도면형식
        +convertDrawings()
    }
    class 인테리어선택부 {
        +String 선택사항
        +selectInterior()
    }
    class 견적산출부 {
        +String 견적정보
        +calculateEstimate()
    }
    관리서버 --> 가상박람회부 : "관리"
    가입부 --> 가상박람회부 : "연결"
    모형제작부 --> 가상박람회부 : "연동"
    도면변환부 --> 가상박람회부 : "데이터 제공"
    인테리어선택부 --> 가상박람회부 : "연결"
    견적산출부 --> 인테리어선택부 : "연계"