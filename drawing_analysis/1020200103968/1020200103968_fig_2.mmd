classDiagram
    class 지식처리부 {
        +String 자연어질문
        +processQuestion()
    }
    class 지식추론부 {
        +String 부분지식그래프
        +inferAnswer()
    }
    class 입력처리부 {
        +String 시드개체
        +extractFeatures()
    }
    class 부분지식생성부 {
        +String 부분지식베이스
        +generateKnowledgeBase()
    }
    class 추론경로유도부 {
        +String 추론경로
        +induceInferencePath()
    }
    class 개체특징갱신부 {
        +String 개체특징
        +updateEntityFeatures()
    }
    입력처리부 --> 지식처리부 : "지식 처리부의 일부로 작동"
    부분지식생성부 --> 지식처리부 : "지식 처리부의 일부로 작동"
    추론경로유도부 --> 지식추론부 : "지식 추론부의 일부로 작동"
    개체특징갱신부 --> 지식추론부 : "지식 추론부의 일부로 작동"
    지식처리부 --> 지식추론부 : "질문에 대한 답변을 추론하기 위해 사용됨"