%% 1020200076842 - 주식을 이용한 충전 및 결제 시스템 블럭도
%% 생성일: 2026-05-11

classDiagram
    class 고객단말 {
        +String 전자화폐
        +결제요청()
    }
    class 전자화폐결제서버 {
        +String 결제금액
        +결제진행()
    }
    class 계정관리서버 {
        +String 계정정보
        +정산()
    }
    class 결제단말 {
        +String 거래상태
        +결제요청()
    }
    class 주식관리서버 {
        +String 주식정보
        +주식정보제공()
    }
    class 지불보증서버 {
        +String 충전정보
        +충전진행()
    }
    
    고객단말 --> 전자화폐결제서버 : "결제 요청"
    전자화폐결제서버 --> 계정관리서버 : "매입 요청"
    계정관리서버 <-- 전자화폐결제서버 : "매입 요청 수신"
    계정관리서버 <-- 지불보증서버 : "충전 요청"
    지불보증서버 --> 고객단말 : "충전 요청 수신"
    지불보증서버 --> 계정관리서버 : "충전 정보 제공"
    주식관리서버 --> 지불보증서버 : "주식 정보 제공"
    결제단말 <-- 고객단말 : "결제 요청"