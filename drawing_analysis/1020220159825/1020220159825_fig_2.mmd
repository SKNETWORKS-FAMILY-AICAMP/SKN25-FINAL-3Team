        +processInfo()
        +generateRecommendations()
    }
    class 정보수집모듈 {
        +collectData()
    }
    class 우선순위생성모듈 {
        +generatePriority()
    }
    class 가격산출모듈 {
        +calculatePrice()
    }
    class 신뢰도산출모듈 {
        +calculateTrust()
    }
    class 업체평가모듈 {
        +evaluatePerformance()
    }
    class 리워드산출모듈 {
        +calculateReward()
    }

    업체단말 --> 서버 : "정보 수집"
    고객단말 --> 서버 : "정보 수집"
