classDiagram
    class 검출이미지 {
        +String 이미지데이터
    }
    class 결정될타겟 {
        +String 물체정보
    }
    class 소속카테고리 {
        +String 카테고리정보
    }
    class 위치오프셋값 {
        +String 보정값
    }
    class 신뢰도 {
        +String 타겟신뢰도
    }
    class 컨볼루션뉴럴네트워크 {
        +process()
    }
    검출이미지 --> 컨볼루션뉴럴네트워크 : "입력 이미지 처리"
    컨볼루션뉴럴네트워크 --> 신뢰도 : "신뢰도 계산"
    컨볼루션뉴럴네트워크 --> 결정될타겟 : "소속 카테고리 결정"
    결정될타겟 --> 소속카테고리 : "소속 카테고리 결정"
    결정될타겟 --> 위치오프셋값 : "위치 오프셋 값 결정"
    신뢰도 --> 결정될타겟 : "결정될 타겟에 대한 신뢰도"