classDiagram
    class 입력벡터엘리먼트레지스터 {
        +String element
        +receiveElement()
    }
    class 일시적인감소엘리먼트레지스터 {
        +String tempElement
        +receiveTempElement()
    }
    class 계산회로 {
        +calculate()
    }
    class 결과레지스터 {
        +String result
        +receiveResult()
    }
    class 제어레지스터 {
        +String controlVector
        +receiveControlVector()
    }
    class 출력회로 {
        +outputResult()
    }
    입력벡터엘리먼트레지스터 --> 계산회로 : "사용"
    일시적인감소엘리먼트레지스터 --> 계산회로 : "사용"
    계산회로 --> 결과레지스터 : "결과 수신"
    결과레지스터 --> 출력회로 : "결과 제공"