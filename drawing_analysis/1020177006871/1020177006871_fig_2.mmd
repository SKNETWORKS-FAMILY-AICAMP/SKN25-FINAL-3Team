        +int 글자수
        +판단()
    }
    class 연산모듈 {
        +float 신뢰수준
        +연산()
    }
    class 제2판단모듈 {
        +boolean 정확성
        +판단()
    }
    class 출력모듈 {
        +String 결과
        +출력()
    }
    이미지획득모듈 --> 할당모듈 : "답안 이미지 획득"
    할당모듈 --> 제1판단모듈 : "할당 결과 판단"
    제1판단모듈 --> 연산모듈 : "판단 결과 기반 연산"
    연산모듈 --> 제2판단모듈 : "신뢰수준 기반 판단"
