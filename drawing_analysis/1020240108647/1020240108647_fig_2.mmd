%% 1020240108647 - 정전식 버튼용 햅틱 장치의 구성도
%% 생성일: 2026-05-11

classDiagram
    class 터치제어모듈 {
        +String 트리거신호
        +detectTouch()
    }
    class 햅틱제어모듈 {
        +String 진동데이터
        +driveHaptic()
    }
    class 진동소자및클릭커소자 {
        +String 피드백형태
        +provideHapticFeedback()
    }
    터치제어모듈 --> 햅틱제어모듈 : "트리거 신호를 출력"
    햅틱제어모듈 --> 터치제어모듈 : "트리거 신호를 입력받음"
    햅틱제어모듈 --> 진동소자및클릭커소자 : "진동소자와 클릭커소자를 구동"
    진동소자및클릭커소자 --> 햅틱제어모듈 : "햅틱제어모듈에 의해 구동됨"