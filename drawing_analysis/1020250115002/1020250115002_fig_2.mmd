classDiagram
    class 단백질서열데이터 {
        +String 데이터
        +전처리()
    }
    class 스펙트럼라이브러리 {
        +String 라이브러리데이터
        +구축()
    }
    class PMSM데이터 {
        +String 예측데이터
        +생성()
    }
    class PMSM스코어링모델 {
        +String 평가결과
        +평가()
    }
    class 펩타이드분류기 {
        +String 분류결과
        +학습()
    }
    class 펩타이드동정결과 {
        +String 결과데이터
        +생성()
    }
    단백질서열데이터 --> 스펙트럼라이브러리 : "기반"
    스펙트럼라이브러리 --> PMSM데이터 : "생성됨"
    PMSM데이터 --> PMSM스코어링모델 : "평가"
    PMSM스코어링모델 --> 펩타이드분류기 : "학습"
    펩타이드분류기 --> 펩타이드동정결과 : "생성됨"