classDiagram
    class 영상입력모듈 {
        +String 영상데이터
        +영상획득()
    }
    class 신체부위인식모듈 {
        +String 랜드마크좌표
        +랜드마크산출()
    }
    class 복장탐지모듈 {
        +String 복장정보
        +복장탐지()
    }
    class 매핑분석모듈 {
        +String 특징벡터
        +지표산출()
    }
    class 적합성판단모듈 {
        +boolean 적합여부
        +판단()
    }
    class 복장규정데이터베이스 {
        +String 규정정보
    }

    영상입력모듈 --> 신체부위인식모듈 : "영상 전달"
    신체부위인식모듈 --> 복장탐지모듈 : "랜드마크 좌표 전달"
    복장탐지모듈 --> 매핑분석모듈 : "복장 정보 전달"
    매핑분석모듈 --> 적합성판단모듈 : "특징 벡터 전달"