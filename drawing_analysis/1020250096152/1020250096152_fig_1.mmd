%% 1020250096152 - 감정강도 기반 콘텐츠 크기 가변 디스플레이 시스템 블록도
%% 생성일: 2026-05-11

classDiagram
    class 컨트롤장치 {
        +String 콘텐츠정보
        +입력받기()
    }
    class 콘텐츠관리서버 {
        +String 저장된정보
        +관리하기()
    }
    class 감정측정부 {
        +String 감정정보
        +측정하기()
    }
    class 크기조절부 {
        +String 크기정보
        +조절하기()
    }
    class 효과설정부 {
        +String 시각효과정보
        +설정하기()
    }
    class 출력제어부 {
        +String 최종콘텐츠정보
        +전송하기()
    }
    class 디스플레이장치 {
        +String 표시정보
        +표시하기()
    }
    컨트롤장치 --> 콘텐츠관리서버 : "입력받은 콘텐츠정보를 관리"
    컨트롤장치 --> 감정측정부 : "사용자의 감정정보를 수집"
    감정측정부 --> 크기조절부 : "감정강도를 기반으로 크기 조절"
    크기조절부 --> 효과설정부 : "최종 콘텐츠정보 생성"
    효과설정부 --> 출력제어부 : "가변 콘텐츠정보와 융합"
    출력제어부 --> 디스플레이장치 : "콘텐츠를 디스플레이장치로 전송"