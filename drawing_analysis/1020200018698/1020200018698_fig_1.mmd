%% 1020200018698 - 컨테이너 기반 클라우드 시스템 구성도
%% 생성일: 2026-05-11

classDiagram
    class InMemoryCluster {
        +String eventData
    }
    class ServerModule {
        +provideEventData()
        +accessWebAPI()
        +replicateData()
        +performAuthentication()
    }
    class DataAccessControlModule {
        +controlDatabaseAccess()
    }
    class DataDistributionModule {
        +replicateDataBetweenDatabases()
        +detectTraffic()
    }
    class SecurityModule {
        +storeAuthenticationKey()
        +performUserAuthentication()
    }
    class ManagementModule {
        +adjustSecurityModuleCount()
    }
    
    InMemoryCluster <|-- ServerModule : "이벤트 데이터 제공"
    ServerModule --> DataAccessControlModule : "Web API 접근"
    ServerModule --> DataDistributionModule : "데이터 복제"
    ServerModule --> SecurityModule : "인증 수행"
    DataAccessControlModule --> ServerModule : "서비스 모듈과 연결"
    DataDistributionModule --> InMemoryCluster : "데이터 복제"
    DataDistributionModule --> ManagementModule : "트래픽 감지"
    SecurityModule --> InMemoryCluster : "인증 키 저장"
    ManagementModule --> SecurityModule : "보안 모듈 조절"