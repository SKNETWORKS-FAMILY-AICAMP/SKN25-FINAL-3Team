        +String 데이터처리
        +서비스제공()
    }
    class 경로안내부 {
        +String 경로정보
        +안내서비스()
    }
    class 매칭부 {
        +String 취미정보
        +매칭수행()
    }
    class 테마별추천부 {
        +String 추천상품
        +추천서비스()
    }
    class 아이템중개부 {
        +String 거래정보
        +거래중개()
    }
    class 예약관리부 {
