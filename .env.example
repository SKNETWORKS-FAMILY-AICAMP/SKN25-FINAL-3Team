# ==========================================
# Django Settings
# ==========================================
# 보안을 위해 실제 환경에서는 복잡하고 긴 문자열을 사용하세요.
SECRET_KEY=django-insecure-your-secret-key-here

# 개발 환경에서는 True, 배포 환경(운영)에서는 False로 설정하세요.
DEBUG=True

# 허용할 호스트 (콤마로 구분)
ALLOWED_HOSTS=*,localhost,127.0.0.1

# CSRF 신뢰할 수 있는 도메인 (ngrok 등 사용 시)
CSRF_TRUSTED_ORIGINS=https://simply-subsiding-crunchy.ngrok-free.dev

# ==========================================
# AI / LangChain Settings
# ==========================================
OPENAI_API_KEY=sk-your-openai-api-key
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=skn25-final-3team