# 공통 환경변수 예시 파일
# 사용법: 이 파일을 .env로 복사한 뒤 실제 값만 채워 넣으세요.
# 주의: 실제 .env는 Git에 올리지 않습니다.

# ─────────────────────────────────────────────
# OpenAI / LLM
# ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────
# Patent Agent DB
# 상담/선행기술 에이전트가 쓰는 DB입니다.
# 1) DATABASE_URL을 쓰면 DB_*보다 우선 사용됩니다.
# 2) DATABASE_URL을 비우면 DB_* 조합으로 연결 문자열을 만듭니다.
# ─────────────────────────────────────────────
DATABASE_URL=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=

# 특허 TXT 원천 데이터 위치. 비우면 기본값 사용:
# data/raw/texts/patents_txt
PATENTS_TEXT_DIR=

# ─────────────────────────────────────────────
# Claims Agent / 외부 백엔드 API
# 런팟/외부 FastAPI 주소. 맨 뒤 슬래시(/)는 빼세요.
# ─────────────────────────────────────────────
CLAIM_BACKEND_URL=

# ─────────────────────────────────────────────
# Django backend
# 기본값은 로컬 SQLite입니다. MySQL을 쓰려면 아래 값을 채우세요.
# ─────────────────────────────────────────────
SECRET_KEY=
DEBUG=True
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=backend/django/db.sqlite3
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=
