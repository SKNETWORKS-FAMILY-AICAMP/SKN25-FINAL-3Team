# 사용법: cp .env.example .env 후 실제 값을 채워 넣으세요.
# 주의: .env는 절대 git에 커밋하지 마세요.

# ─────────────────────────────────────────────
# LLM
# ─────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini

# LangSmith 트레이싱 (선택)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# ─────────────────────────────────────────────
# Django
# ─────────────────────────────────────────────
SECRET_KEY=your_django_secret_key_here   # python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=True

# ─────────────────────────────────────────────
# Database (PostgreSQL)
# Docker: DJANGO_DB_HOST=db  (docker-compose 서비스명)
# 로컬:   DJANGO_DB_HOST=localhost
# ─────────────────────────────────────────────
POSTGRES_DB=patent_ai
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=patent_ai
DJANGO_DB_USER=your_postgres_user
DJANGO_DB_PASSWORD=your_postgres_password
DJANGO_DB_HOST=db
DJANGO_DB_PORT=5432

# SQLAlchemy용 (prior_art_agent 등)
# Docker:  @db:5432
# 로컬:    @localhost:5432
DATABASE_URL=postgresql+psycopg2://your_postgres_user:your_postgres_password@db:5432/patent_ai

# RDS (배포 환경)
RDS_DATABASE_URL=postgresql://your_db_user:your_db_password@your_rds_endpoint:5432/postgres

# ─────────────────────────────────────────────
# AWS / S3
# ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=ap-northeast-2

S3_BUCKET=your_s3_bucket_name
S3_PREFIX=kipris/raw/bibliography_xml/

# ─────────────────────────────────────────────
# 에이전트 설정
# ─────────────────────────────────────────────
PRIOR_ART_ANALYZE_MAX_WORKERS=5
PATENTS_TEXT_DIR=        # 비우면 data/raw/texts/patents_txt 사용
CLAIM_BACKEND_URL=       # 외부 FastAPI 주소 (맨 뒤 슬래시 제외)
HUGGINGFACE_TOKEN=
LORA_HF_REPO=

RUNPOD_VLLM_URL=
RUNPOD_API_KEY=
# ─────────────────────────────────────────────
# 모니터링 (Phoenix / OpenTelemetry)
# Docker: http://phoenix:6006/v1/traces
# 로컬:   http://localhost:6006/v1/traces
# ─────────────────────────────────────────────
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
LOG_LEVEL=INFO
ENV=dev   # dev → 텍스트 로그 / prod → JSON 구조화 로그
