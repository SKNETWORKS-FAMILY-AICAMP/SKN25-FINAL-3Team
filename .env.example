# ─────────────────────────────────────────────
# API Keys / Tokens (실제 발급받은 키로 교체하세요)
# ─────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY=your_langchain_api_key_here

HUGGING_FACE_TOKEN=your_hugging_face_token_here
LORA_HF_REPO="your_hf_repo_name/claim"

RUNPOD_VLLM_URL=https://your_runpod_url_here/v1
RUNPOD_API_KEY=your_runpod_api_key_here

# ─────────────────────────────────────────────
# OpenAI / LLM
# ─────────────────────────────────────────────
OPENAI_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────
# Service Runtime
# Docker 배포 시 patent-api 컨테이너가 읽는 값입니다.
# ─────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=2
PATENT_API_PORT=8000
CORS_ORIGINS=*
ARTIFACT_ROOT=/app/artifacts
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────
# Patent Agent DB / Session Storage
# 1) DATABASE_URL을 쓰면 DB_*보다 우선 사용됩니다.
# 2) Docker compose 기본값은 postgres service입니다.
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://<user>:<password>@postgres:5432/postgres
RDS_DATABASE_URL=postgresql+psycopg2://<user>:<password>@<rds_endpoint_url>:5432/postgres?sslmode=require

DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=patent_ai

POSTGRES_DB=patent_ai
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# ─────────────────────────────────────────────
# AWS / S3 Configuration
# ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=ap-northeast-2

S3_BUCKET=your_s3_bucket_name
S3_PREFIX=kipris/raw/bibliography_xml/

# 특허 TXT 원천 데이터 위치. 비우면 기본값 사용:
# data/raw/texts/patents_txt
PATENTS_TEXT_DIR=

# ─────────────────────────────────────────────
# Claims Agent / 외부 백엔드 API
# 런팟/외부 FastAPI 주소. 맨 뒤 슬래시(/)는 빼세요.
# ─────────────────────────────────────────────
CLAIM_BACKEND_URL=

# ─────────────────────────────────────────────
# Django backend
# 기본값은 로컬 SQLite입니다. MySQL을 쓰려면 아래 값을 채우세요.
# ─────────────────────────────────────────────
SECRET_KEY=your_django_secret_key_here
DEBUG=True
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=backend/django/db.sqlite3
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=

PRIOR_ART_ANALYZE_MAX_WORKERS=5