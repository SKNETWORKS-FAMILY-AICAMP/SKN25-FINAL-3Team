# 공통 환경변수 예시 파일
# 사용법: 이 파일을 .env로 복사한 뒤 실제 값만 채워 넣으세요.
# 주의: 실제 .env는 Git에 올리지 않습니다.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  Docker Compose 기동 시 최소 필수 설정                                  │
# │    OPENAI_API_KEY     — 반드시 입력                                     │
# │    DB_PASSWORD        — 기본값(patent_pw)은 로컬 개발 전용              │
# │    SECRET_KEY         — 기본값은 로컬 개발 전용, 배포 시 변경 필수       │
# │    HUGGINGFACE_TOKEN  — --profile llm (claim-api) 사용 시만 필수        │
# └─────────────────────────────────────────────────────────────────────────┘

# ─────────────────────────────────────────────
# OpenAI / LLM
# ─────────────────────────────────────────────
OPENAI_API_KEY=          # 필수: sk-...
OPENAI_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────
# Docker Compose — PostgreSQL (postgres 서비스)
# docker-compose.yml 의 postgres 서비스가 이 값으로 DB를 생성합니다.
# ─────────────────────────────────────────────
DB_USER=patent
DB_PASSWORD=patent_pw    # 프로덕션에서 반드시 변경!
DB_NAME=patent_ai

# ─────────────────────────────────────────────
# Patent Agent DB (fastapi / streamlit 서비스)
# Docker Compose 환경에서는 DATABASE_URL 을 비워두면
# docker-compose.yml 이 자동으로 postgres 서비스를 가리킵니다.
# 외부 DB(Supabase 등)를 직접 지정하려면 DATABASE_URL 에 입력하세요.
# ─────────────────────────────────────────────
DATABASE_URL=
DB_HOST=                 # Docker 내부에서는 compose가 postgres로 지정 (직접 입력 불필요)
DB_PORT=5432

# 특허 TXT 원천 데이터 위치. 비우면 기본값 사용:
# data/raw/texts/patents_txt
PATENTS_TEXT_DIR=

# ─────────────────────────────────────────────
# Critic Agent (claim-api) — --profile llm 시만 필요
# ─────────────────────────────────────────────
CLAIM_BACKEND_URL=       # 비우면 내부 http://claim-api:8001 사용
HUGGINGFACE_TOKEN=       # claim-api 에서 EXAONE 모델 다운로드 시 필수
LORA_HF_REPO=silverstone1004/claim

# ─────────────────────────────────────────────
# Django backend (JWT 인증 서비스)
# Docker Compose 에서는 DJANGO_DB_* 가 postgres 서비스를 가리킵니다.
# ─────────────────────────────────────────────
SECRET_KEY=              # 프로덕션에서 반드시 변경!
DEBUG=True
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=patent_ai
DJANGO_DB_USER=patent
DJANGO_DB_PASSWORD=patent_pw
DJANGO_DB_HOST=postgres  # Docker 내부 서비스명
DJANGO_DB_PORT=5432

# ─────────────────────────────────────────────
# React Frontend 프록시 (개발 서버 기본값)
# ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
