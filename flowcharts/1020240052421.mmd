    C --> D[컨테이너 작업 데이터 분석 및 처리]
    C --> E[데이터 보고서 및 통계 분석]
    C --> F[컨테이너 작업 의사결정]
    C --> G[컨테이너 조작 프로세스 최적화]
    A --> H[작업 배치 모듈]
    H --> I[태스크 분배]
    H --> J[작업 최적화]
    H --> K[하역 선박 기획 및 배치]
    A --> L[사물인터넷 집적 모니터링 모듈]
    L --> M[부두 설비 실시간 모니터링]
    L --> N[운영 상태 및 효율 모니터링]
    L --> O[원격 장애 진단 및 예측성 유지보수]
    A --> P[통신관리 모듈]
    P --> Q[정보 전달 보장]
    P --> R[데이터 교환 및 통신 구현]
    A --> S[친환경 에너지 관리 및 최적화 모듈]
    S --> T[에너지 사용 상황 실시간 모니터링]
    S --> U[에너지 절감 제안 및 최적화 방안 제출]
    A --> V[가상 현실 모의 모듈]
    V --> W[모의 교육 환경 제공]
    V --> X[작업 프로세스 및 설비 배치 시뮬레이션]