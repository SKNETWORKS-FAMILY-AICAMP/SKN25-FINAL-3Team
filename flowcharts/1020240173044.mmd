    A2 --> A3[제1 가중치 처리 샘플 생성 및 저장]
    A3 --> A4[정보 이득율 기준의 최적 분할 특징 선택]
    A4 --> A5[제1 의사결정 트리 모델 학습]
    A5 --> A6[예측값과 실제 가치의 차이 계산]
    A6 --> A7[제1 전체 오차 산출]
    A7 --> A8[산출된 예측 오차 기반으로 제2 가중치 벡터 생성]
    A8 --> A9[제2 의사결정 트리 모델 학습]
    A9 --> A10[제2 전체 오차 산출]
