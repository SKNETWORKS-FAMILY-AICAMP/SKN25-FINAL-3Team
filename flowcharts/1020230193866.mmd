flowchart TD
    A[상점 단말기 설치] --> B[상품관리 수행]
    B --> C[주문관리 수행]
    C --> D[판매관리 수행]
    D --> E[배송관리 수행]
    E --> F[고객관리 수행]
    F --> G[영업관리 수행]
    G --> H[매출관리 수행]
    H --> I[재고관리 수행]
    I --> J[오프라인 매출정보 생성]
    J --> K[소비자 단말기 설치]
    K --> L[상품검색 수행]
    L --> M[주문 수행]
    M --> N[배송요청 수행]
    N --> O[재고식별 수행]
    O --> P[반품요청 수행]
    P --> Q[상품판매방송 제공]
    Q --> R[제1온라인 매출정보 생성]
    R --> S[오픈마켓 서비스 제공]
    S --> T[제2온라인 매출정보 생성]
    T --> U[온오프라인 매출정보 저장]
    U --> V[상점영업정보 실시간 업데이트]
    V --> W[판매 예측 수행]
    W --> X[상점정보 저장]
